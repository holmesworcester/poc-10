# Core runtime table inventory.
#
# These tables are protocol-neutral mechanics. Protocol fact modules may cause
# rows to be written here through projection, intent dispatch, and commands, but
# they should not add semantic columns to this file. Put protocol-owned storage
# beside the module that owns its row layout and queries.

# Immutable fact bytes by content id. Scope and admission ordering are local
# metadata in local_fact_admissions rather than part of the content hash.
table facts {
  column id bytes(32);
  column bytes bytes;
  row_key (id);
}
# Local-only admission facts about durable fact bytes. This relation is not a
# protocol-synced fact stream. The received_at column is the admission time in
# the target model; the current Rust Fact.timestamp field still feeds it until
# event-time ordering moves fully into protocol-derived indexes.
table local_fact_admissions {
  column id bytes(32);
  column fact_id bytes(32);
  column scope text;
  column scope_kind text;
  column scope_id bytes(32);
  column received_at u64;
  column bytes bytes;
  row_key (id);
  unique index by_fact (fact_id);
  index by_scope_received_at (scope, scope_kind, scope_id, received_at);
}

# Standing context rows emitted by projection. `owner` is the fact whose
# projection owns the row; replacing context deletes by owner and reinserts the
# new complete set. `direction + role + scope_key + selector` is the matching
# surface used by exact context and custom matcher SQL.
table context_edges {
  column owner bytes(32);
  column direction text;
  column role text;
  column scope_key bytes;
  column selector bytes;
  row_key (owner, direction, role, scope_key, selector);
  index by_match (direction, role, scope_key, selector);
  index by_owner (owner);
}

# Standing schedules emitted by projection. These are replacement rows owned by
# the projecting fact. Due ranges are copied to pending_time_ranges when the
# daemon admits a time wake, then cleared when that fact projects.
table time_wakes {
  column timeline text;
  column at u64;
  column owner bytes(32);
  row_key (timeline, at, owner);
  index by_owner (owner);
}

# Fact ids awaiting projection. Successful projection removes the row at the
# same durable boundary as replacement context and effects. A failed projection
# leaves the owner queued; a stale row whose fact was already removed is purged.
table pending_projection {
  column owner bytes(32);
  row_key (owner);
}

# Transient due-time context for pending facts. Rows are produced from
# time_wakes by the daemon and consumed by the next successful projection.
table pending_time_ranges {
  column owner bytes(32);
  column timeline text;
  column has_start bool;
  column start_exclusive u64;
  column end_inclusive u64;
  row_key (owner, timeline, has_start, start_exclusive, end_inclusive);
}

# Durable idempotent handler work. Queue identity is `(kind, idempotence_key)`;
# re-emitting the same payload is a no-op and a different payload is rejected.
table intents {
  column kind text;
  column idempotence_key bytes;
  column payload bytes;
  row_key (kind, idempotence_key);
}

# Restart-local idempotent handler work. This table is SQLite TEMP storage, so
# inbound network frames and other process-local work never survive restart.
memory table local_intents {
  column kind text;
  column idempotence_key bytes;
  column payload bytes;
  row_key (kind, idempotence_key);
}

# Store-local logical clock used by CLI/test workflows to choose deterministic
# timestamps. It is not protocol truth and is not synced.
table clock {
  column key text;
  column timestamp u64;
  row_key (key);
}
