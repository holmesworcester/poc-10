  column key bytes;
  column value bytes;
  row_key (key);
}

table recipient_key_rows {
  column key bytes;
  column value bytes;
  row_key (key);
}

table key_wrap_rows {
  column key bytes;
  column value bytes;
  row_key (key);
}

table user_rows {
  column key bytes;
  column value bytes;
  row_key (key);
}

table local_endpoint_rows {
  column key bytes;
  column value bytes;
  row_key (key);
}

table local_endpoint_secret_rows {
  column key bytes;
  column value bytes;
  row_key (key);
}

