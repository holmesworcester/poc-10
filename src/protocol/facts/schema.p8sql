# Initial poc-10 fact-module projection table inventory.
# Row table declarations list durable ownership without migrating behavior yet.

row_table message_rows;
row_table opened_message_rows;
row_table sealed_message_rows;
row_table message_tombstone_rows;
row_table file_rows;
row_table file_slice_rows;
row_table workspace_rows;
row_table recipient_key_rows;
row_table key_wrap_rows;
row_table user_rows;
row_table local_endpoint_rows;
row_table local_endpoint_secret_rows;
row_table local_endpoint_signing_public_key_rows;
row_table local_endpoint_signing_secret_rows;
row_table identity_endpoint_shared_rows;
row_table content_event_rows;
row_table cascade_staged_fact_rows;
row_table admin_rows;
row_table reaction_rows;

table content_messages {
  column workspace_id bytes(32);
  column message_id bytes(32);
  column author_user_id bytes(32);
  column created_at_ms u64;
  column sealed_message_id bytes(32);
  column deleted bool;
  row_key (workspace_id, message_id);
  index by_workspace_created (workspace_id, created_at_ms);
}

table content_reactions {
  column workspace_id bytes(32);
  column message_id bytes(32);
  column reaction_id bytes(32);
  column author_user_id bytes(32);
  column created_at_ms u64;
  column deleted bool;
  row_key (workspace_id, reaction_id);
  index by_message (workspace_id, message_id, created_at_ms);
}

table content_files {
  column workspace_id bytes(32);
  column message_id bytes(32);
  column file_id bytes(32);
  column author_user_id bytes(32);
  column created_at_ms u64;
  column root_hash bytes(32);
  column byte_len u64;
  column deleted bool;
  row_key (workspace_id, file_id);
  index by_message (workspace_id, message_id, created_at_ms);
}

row_table content_message_rows;
row_table connection_ephemeral_secret_rows;
row_table connection_request_rows;
row_table connection_response_rows;
row_table invite_accepted_rows;
row_table invite_server_rows;
row_table user_invite_rows;
row_table device_invite_rows;
row_table invite_secret_rows;
row_table sync_compare_rows;
row_table sync_have_id_rows;
row_table sync_need_id_rows;
row_table sync_shareable_fact_rows;
row_table message_deletion_rows;
row_table file_deletion_rows;
row_table removal_frontier_rows;
row_table local_history_node_secret_rows;
row_table disappearing_messages_setting_rows;
