  column key bytes;
  column value bytes;
  row_key (key);
}

table local_endpoint_signing_secret_rows {
  column key bytes;
  column value bytes;
  row_key (key);
}

table identity_endpoint_shared_rows {
  column key bytes;
  column value bytes;
  row_key (key);
}

table content_event_rows {
  column key bytes;
  column value bytes;
  row_key (key);
}

table cascade_staged_fact_rows {
  column key bytes;
  column value bytes;
  row_key (key);
}

table admin_rows {
  column key bytes;
  column value bytes;
  row_key (key);
}

table reaction_rows {
  column key bytes;
  column value bytes;
  row_key (key);
}

table content_messages {
  column workspace_id bytes(32);
  column message_id bytes(32);
  column author_user_id bytes(32);
  column created_at_ms u64;
  column sealed_message_id bytes(32);
  column deleted bool;
  row_key (workspace_id, message_id);
  index by_workspace_created (workspace_id, created_at_ms);
}

table content_reactions {
  column workspace_id bytes(32);
  column message_id bytes(32);
  column reaction_id bytes(32);
  column author_user_id bytes(32);
  column created_at_ms u64;
  column deleted bool;
  row_key (workspace_id, reaction_id);
  index by_message (workspace_id, message_id, created_at_ms);
}

table content_files {
  column workspace_id bytes(32);
  column message_id bytes(32);
  column file_id bytes(32);
  column author_user_id bytes(32);
  column created_at_ms u64;
  column root_hash bytes(32);
  column byte_len u64;
  column deleted bool;
  row_key (workspace_id, file_id);
  index by_message (workspace_id, message_id, created_at_ms);
}

table content_message_rows {
  column key bytes;
  column value bytes;
  row_key (key);
}

