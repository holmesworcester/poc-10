# Initial poc-10 fact-module projection table inventory.
# These declarations list durable ownership without migrating behavior yet.

table message_rows {
  column key bytes;
  column value bytes;
  row_key (key);
}

table opened_message_rows {
  column key bytes;
  column value bytes;
  row_key (key);
}

table sealed_message_rows {
  column key bytes;
  column value bytes;
  row_key (key);
}

