  column key bytes;
  column value bytes;
  row_key (key);
}

table connection_attempt_checkpoints {
  column key bytes;
  column value bytes;
  row_key (key);
}

table network_send_cursors {
  column key bytes;
  column value bytes;
  row_key (key);
}
